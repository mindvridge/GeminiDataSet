# ===========================================
# 한국어 심리상담 데이터셋 구축 파이프라인
# 환경 설정 파일 예시
# ===========================================
# 이 파일을 .env로 복사하고 실제 값을 입력하세요.
# cp .env.example .env

# ==================== Google Cloud 설정 ====================
# Google Cloud 프로젝트 ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI 리전 (Gemini 3 Preview 모델 배포 리전)
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI 사용 여부 (True: Vertex AI, False: AI Studio)
GOOGLE_GENAI_USE_VERTEXAI=True

# ==================== Gemini 모델 설정 ====================
# Gemini 3 Pro 모델 (Track A: 고위험군 데이터 생성)
# 깊은 추론과 Thinking Mode를 지원하는 Pro 모델
GEMINI_PRO_MODEL=gemini-3-pro-preview

# Gemini 3 Flash 모델 (Track B: 일반상담 데이터 생성)
# 비용 효율적인 Flash 모델
GEMINI_FLASH_MODEL=gemini-3-flash-preview

# ==================== 생성 설정 ====================
# 최대 출력 토큰 수
MAX_OUTPUT_TOKENS=8192

# Pro 모델 온도 (0.0~1.0, 높을수록 창의적)
TEMPERATURE_PRO=0.7

# Flash 모델 온도
TEMPERATURE_FLASH=0.8

# ==================== 배치 처리 설정 ====================
# 배치당 처리 데이터 수
BATCH_SIZE=10

# 최대 동시 요청 수 (Rate Limit 고려)
MAX_CONCURRENT_REQUESTS=5

# API 호출 재시도 횟수
RETRY_ATTEMPTS=3

# 재시도 간 대기 시간 (초)
RETRY_DELAY=2.0

# ==================== 품질 검증 설정 ====================
# 검증 샘플링 비율 (0.0~1.0)
VALIDATION_SAMPLE_RATE=0.2

# 최소 공감 점수 (1~5)
MIN_EMPATHY_SCORE=3

# 최소 한국어 자연스러움 점수 (1~5)
MIN_KOREAN_NATURALNESS=3

# ==================== 로깅 설정 ====================
# 로깅 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==================== 보안 주의사항 ====================
# 1. 이 파일(.env)을 절대 Git에 커밋하지 마세요
# 2. .gitignore에 .env가 포함되어 있는지 확인하세요
# 3. 프로덕션 환경에서는 시크릿 관리 서비스 사용을 권장합니다
# 4. BLOCK_NONE 설정 사용 시 생성된 데이터 보안에 주의하세요
